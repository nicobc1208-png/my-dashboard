# Nick Digital — Notion Prospect Pages Builder
# Copy this file to .env and fill in your values

# 1. Go to https://www.notion.so/my-integrations
#    Create an integration → copy the "Internal Integration Secret"
NOTION_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Open the Notion page that CONTAINS your "medspas prospects" page
#    (i.e., the parent page where you want the new niche pages to live)
#    Click the three dots (•••) → "Copy link"
#    The ID is the 32-char hex at the end of the URL:
#    https://www.notion.so/Your-Page-Title-<THIS-IS-THE-ID>
PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Share your parent page with the integration:
#    Open the parent page in Notion → Share → Invite → pick your integration
